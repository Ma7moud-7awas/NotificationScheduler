# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# TikXML Rules
# Keep the library classes
-keep class com.tickaroo.tikxml.** { *; }

# Keep generated TypeAdapters
-keep class **$$TypeAdapter { *; }

# Keep attributes required for generic type reflection (Fixes "Object" error)
-keepattributes Signature, InnerClasses, EnclosingMethod, *Annotation*

# Keep model classes annotated with TikXML annotations
-keep @com.tickaroo.tikxml.annotation.Xml class * { *; }

# Keep annotated fields/methods to prevent them from being renamed or removed
-keepclasseswithmembers class * {
    @com.tickaroo.tikxml.annotation.* <fields>;
    @com.tickaroo.tikxml.annotation.* <methods>;
}